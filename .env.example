# ==============================================================================
# Scribble Application Environment Configuration (Template)
# Copy this file to '.env' and fill in your actual credentials.
# DO NOT commit '.env' with real secrets to public repositories.
# ==============================================================================

# Cloudinary Credentials (Image Uploads & CDN)
# Found in: Cloudinary Console -> Settings -> Upload Presets
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Firebase Configuration
# Found in: Firebase Console -> Project Settings -> General -> Your apps
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_APP_ID_ANDROID=1:your_project_number:android:your_app_hash
FIREBASE_APP_ID_WEB=1:your_project_number:web:your_app_hash
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
